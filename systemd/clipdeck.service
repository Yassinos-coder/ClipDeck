[Unit]
Description=ClipDeck — clipboard manager & launcher
Documentation=https://github.com/Yassinos-coder/ClipDeck
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/clipdeck
Restart=on-failure
RestartSec=5

# X11 / D-Bus environment (needed when launched by systemd, not the shell)
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
PassEnvironment=DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR

# Resource limits — ClipDeck is lightweight
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=graphical-session.target
