[Unit]
Description=ClipDeck — clipboard manager & launcher
Documentation=https://github.com/Yassinos-coder/ClipDeck
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/clipdeck
Restart=on-failure
RestartSec=5

# Inherit display and auth from the graphical session environment.
# GNOME / Pop!_OS imports these into the systemd user daemon automatically.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
PassEnvironment=DISPLAY XAUTHORITY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR

# Resource limits — ClipDeck is lightweight
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=graphical-session.target
